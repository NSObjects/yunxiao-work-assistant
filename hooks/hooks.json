{
  "description": "可选云效 MCP 只读保护；设置 YUNXIAO_READ_ONLY_GUARD=1 时阻止写操作",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/block_yunxiao_writes.py"
          }
        ]
      }
    ]
  }
}
